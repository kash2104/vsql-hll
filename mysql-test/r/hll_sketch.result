INSTALL EXTENSION vsql_hll;
# hll_empty
SELECT hll_empty();
hll_empty()
\x11ae7f
SELECT hll_cardinality(hll_empty());
hll_cardinality(hll_empty())
0
# hll_add
SELECT hll_cardinality(hll_add(hll_add(hll_empty(), hll_hash_text('a')),
hll_hash_text('a')));
hll_cardinality(hll_add(hll_add(hll_empty(), hll_hash_text('a')),
hll_hash_text('a')))
1
SELECT hll_cardinality(hll_add(hll_add(hll_add(hll_empty(), hll_hash_text('a')),
hll_hash_text('b')),
hll_hash_text('c')));
hll_cardinality(hll_add(hll_add(hll_add(hll_empty(), hll_hash_text('a')),
hll_hash_text('b')),
hll_hash_text('c')))
3
SELECT hll_cardinality(hll_add(hll_empty(), 0)),
hll_add(hll_empty(), 0) = hll_empty();
hll_cardinality(hll_add(hll_empty(), 0))	hll_add(hll_empty(), 0) = hll_empty()
0	1
# hll_union
SELECT hll_cardinality(hll_union(
hll_add(hll_add(hll_empty(), hll_hash_text('a')), hll_hash_text('b')),
hll_add(hll_add(hll_empty(), hll_hash_text('b')), hll_hash_text('c'))));
hll_cardinality(hll_union(
hll_add(hll_add(hll_empty(), hll_hash_text('a')), hll_hash_text('b')),
hll_add(hll_add(hll_empty(), hll_hash_text('b')), hll_hash_text('c'))))
3
SELECT hll_union(hll_empty(), hll_empty());
hll_union(hll_empty(), hll_empty())
\x11ae7f
SELECT hll_union(hll_empty(), hll_add(hll_empty(), 42)) = hll_add(hll_empty(), 42),
hll_union(hll_add(hll_empty(), 42), hll_empty()) = hll_add(hll_empty(), 42);
hll_union(hll_empty(), hll_add(hll_empty(), 42)) = hll_add(hll_empty(), 42)	hll_union(hll_add(hll_empty(), 42), hll_empty()) = hll_add(hll_empty(), 42)
1	1
# NULL arguments
SELECT hll_add(NULL, 1), hll_add(hll_empty(), NULL),
hll_union(NULL, hll_empty()), hll_union(hll_empty(), NULL),
hll_cardinality(NULL);
hll_add(NULL, 1)	hll_add(hll_empty(), NULL)	hll_union(NULL, hll_empty())	hll_union(hll_empty(), NULL)	hll_cardinality(NULL)
NULL	NULL	NULL	NULL	NULL
# hll columns
CREATE TABLE t_sketch (id INT PRIMARY KEY, s hll);
INSERT INTO t_sketch VALUES (1, hll_empty());
INSERT INTO t_sketch VALUES (2, hll_add(hll_add(hll_empty(), 1), 2));
INSERT INTO t_sketch VALUES (3, NULL);
SELECT id, hll_cardinality(s) FROM t_sketch ORDER BY id;
id	hll_cardinality(s)
1	0
2	0
3	NULL
SELECT s = hll_add(hll_add(hll_empty(), 1), 2) FROM t_sketch WHERE id = 2;
s = hll_add(hll_add(hll_empty(), 1), 2)
1
UPDATE t_sketch SET s = hll_add(s, hll_hash_text('x')) WHERE id IN (1, 2);
SELECT id, hll_cardinality(s) FROM t_sketch ORDER BY id;
id	hll_cardinality(s)
1	1
2	1
3	NULL
# Text input
INSERT INTO t_sketch VALUES (10, '\\x11ae7f');
INSERT INTO t_sketch VALUES (11, '11ae7f');
INSERT INTO t_sketch VALUES (12, '\\x11ae00');
SELECT id, s, hll_cardinality(s) FROM t_sketch WHERE id >= 10 ORDER BY id;
id	s	hll_cardinality(s)
10	\x11ae7f	0
11	\x11ae7f	0
12	\x11ae7f	0
# PostgreSQL EXPLICIT and SPARSE values
INSERT INTO t_sketch VALUES (13, '\\x12ae7f28df63b7cc57c3cb');
INSERT INTO t_sketch VALUES (14, '\\x13ae7f0f2c10');
INSERT INTO t_sketch VALUES (15, '\\x12ae7f');
INSERT INTO t_sketch VALUES (16, '\\x12ae7f28df63b7cc57c3cb73dedc673db8195b');
INSERT INTO t_sketch VALUES (17, '\\x13ae7f');
SELECT id, hll_cardinality(s), s = hll_add(hll_empty(), hll_hash_bigint(0))
FROM t_sketch WHERE id BETWEEN 13 AND 17 ORDER BY id;
id	hll_cardinality(s)	s = hll_add(hll_empty(), hll_hash_bigint(0))
13	1	1
14	1	1
15	0	0
16	2	0
17	0	0
SELECT id, s = hll_empty() FROM t_sketch WHERE id IN (15, 17) ORDER BY id;
id	s = hll_empty()
15	1
17	1
SELECT s = hll_add(hll_add(hll_empty(), hll_hash_bigint(0)), hll_hash_bigint(100))
FROM t_sketch WHERE id = 16;
s = hll_add(hll_add(hll_empty(), hll_hash_bigint(0)), hll_hash_bigint(100))
1
# Invalid text input
INSERT INTO t_sketch VALUES (20, 'not a sketch');
ERROR HY000: input must be an even number of hex digits, optionally prefixed by \x
INSERT INTO t_sketch VALUES (21, '\\x11ae');
ERROR HY000: hll value is shorter than its 3-byte header
INSERT INTO t_sketch VALUES (22, '\\x21ae7f');
ERROR HY000: unsupported hll schema version 2
INSERT INTO t_sketch VALUES (23, '\\x118b7f');
ERROR HY000: hll value uses log2m=11 and regwidth=5; vsql_hll requires log2m=14 and regwidth=6
INSERT INTO t_sketch VALUES (24, '\\x10ae7f');
ERROR HY000: UNDEFINED hll values are not supported
INSERT INTO t_sketch VALUES (25, '\\x11ae7f00');
ERROR HY000: EMPTY hll value must be exactly 3 bytes
INSERT INTO t_sketch VALUES (26, '\\x12ae7f73dedc673db8195b28df63b7cc57c3cb');
ERROR HY000: EXPLICIT hll elements must be strictly ascending
INSERT INTO t_sketch VALUES (27, '\\x12ae7f0102');
ERROR HY000: EXPLICIT hll value must hold whole 8-byte elements
INSERT INTO t_sketch VALUES (28, '\\x14ae7f00');
ERROR HY000: FULL hll value must be exactly 12291 bytes
SELECT COUNT(*) FROM t_sketch;
COUNT(*)
11
DROP TABLE t_sketch;
UNINSTALL EXTENSION vsql_hll;
