INSTALL EXTENSION vsql_hll;
# hll_hash_bigint
SELECT hll_hash_bigint(0), hll_hash_bigint(100);
hll_hash_bigint(0)	hll_hash_bigint(100)
2945182322382062539	8349353095166695771
SELECT hll_hash_bigint(-1), hll_hash_bigint(9223372036854775807);
hll_hash_bigint(-1)	hll_hash_bigint(9223372036854775807)
-6853156495446839949	7815693464130447828
# hll_hash_boolean
SELECT hll_hash_boolean(FALSE), hll_hash_boolean(TRUE);
hll_hash_boolean(FALSE)	hll_hash_boolean(TRUE)
5048724184180415669	8849112093580131862
SELECT hll_hash_boolean(5) = hll_hash_boolean(TRUE);
hll_hash_boolean(5) = hll_hash_boolean(TRUE)
1
# hll_hash_text
SELECT hll_hash_text('A'), hll_hash_text('AB'), hll_hash_text('');
hll_hash_text('A')	hll_hash_text('AB')	hll_hash_text('')
243126998722523514	5365230931951287672	0
SELECT hll_hash_text('The quick brown fox jumps over the lazy dog');
hll_hash_text('The quick brown fox jumps over the lazy dog')
-2068352364225029268
# hll_hash_bytea_hex
SELECT hll_hash_bytea_hex('4142'), hll_hash_bytea_hex('\\x4142'),
hll_hash_bytea_hex('\\X4142');
hll_hash_bytea_hex('4142')	hll_hash_bytea_hex('\\x4142')	hll_hash_bytea_hex('\\X4142')
5365230931951287672	5365230931951287672	5365230931951287672
SELECT hll_hash_bytea_hex('4a4B') = hll_hash_text('JK');
hll_hash_bytea_hex('4a4B') = hll_hash_text('JK')
1
SELECT hll_hash_bytea_hex(''), hll_hash_bytea_hex('\\x');
hll_hash_bytea_hex('')	hll_hash_bytea_hex('\\x')
0	0
SELECT hll_hash_bytea_hex('XYZ');
hll_hash_bytea_hex('XYZ')
NULL
