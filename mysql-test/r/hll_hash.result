# NULL input
SELECT hll_hash_text(NULL), hll_hash_bigint(NULL),
hll_hash_bytea_hex(NULL), hll_hash_boolean(NULL);
hll_hash_text(NULL)	hll_hash_bigint(NULL)	hll_hash_bytea_hex(NULL)	hll_hash_boolean(NULL)
NULL	NULL	NULL	NULL
# Table columns
CREATE TABLE t_hash (id BIGINT, name VARCHAR(20), active BOOLEAN);
INSERT INTO t_hash VALUES (1, 'alice', TRUE), (2, 'bob', FALSE), (3, NULL, NULL);
SELECT id, hll_hash_bigint(id), hll_hash_text(name), hll_hash_boolean(active)
FROM t_hash ORDER BY id;
id	hll_hash_bigint(id)	hll_hash_text(name)	hll_hash_boolean(active)
1	19144387141682250	5699955792253506986	8849112093580131862
2	-2447670524089286488	-5396685590450884643	5048724184180415669
3	6574508035858270988	NULL	NULL
DROP TABLE t_hash;
UNINSTALL EXTENSION vsql_hll;
